# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.agents/
data/skills/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
/.vercel/

# local tools and caches
/.cache/
/.turbo/
/.eslintcache
/.stylelintcache
/.parcel-cache/

# editor files
/.idea/
/.history/

# typescript
*.tsbuildinfo
next-env.d.ts
